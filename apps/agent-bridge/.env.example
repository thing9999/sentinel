# agent-bridge (호스트에서 실행: npm run dev)
BRIDGE_PORT=3002
# 기본 127.0.0.1 (로컬 전용). Docker의 api 컨테이너에서 접근하려면 0.0.0.0 + BRIDGE_TOKEN 필수
BRIDGE_HOST=127.0.0.1
# 공유 토큰 (api의 AGENT_BRIDGE_TOKEN과 같은 값). 비어 있으면 로컬 전용 모드(127.0.0.1 강제)
BRIDGE_TOKEN=
# 선택: 모델 지정 (비우면 Claude Code 기본 모델)
AGENT_MODEL=
# 선택: SDK 내장 바이너리 대신 쓸 Claude Code 실행 파일 경로
CLAUDE_CODE_PATH=
# 선택: 분석 출력 방식. json_schema(기본, SDK 구조화 출력) | text(텍스트 JSON 파싱 대체 경로)
ADVISOR_OUTPUT_MODE=
