  "size": {
    "$reason": "컨트롤 높이·아이콘·셸 치수는 spacing(간격)과 의미가 달라 spacing으로 표현하면 '간격 토큰을 높이로 쓰는' 혼용이 생긴다. 컴포넌트 치수를 한곳에서 바꾸기 위해 별도 그룹으로 둔다.",
    "control": { "sm": "28px", "md": "32px", "lg": "40px" },
    "badge": { "sm": "20px", "md": "24px", "lg": "32px" },
    "icon": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "24px", "hero": "40px" },
    "tableRow": { "compact": "32px", "default": "40px" },
    "tableHeader": "36px",
    "topBar": "56px",
    "sideNav": { "expanded": "232px", "collapsed": "64px" },
    "connectionBanner": "40px",
    "drawer": { "md": "480px", "lg": "640px" },
    "dialog": { "sm": "400px", "md": "560px" },
    "contentMaxWidth": "1600px",
    "contentPaddingX": "24px",
    "contentPaddingY": "24px",
    "gridGutter": "16px",
    "gridColumns": 12,
    "focusRingWidth": "2px",
    "minHitTarget": "32px"
  },

  "border": {
    "$reason": "선 굵기와 선 모양(실선/점선)은 추정·확정 구분과 stale 표시의 핵심 신호라 컴포넌트마다 다르게 구현되면 안 된다. color/spacing으로 표현할 수 없어 별도 그룹으로 둔다.",
    "width": { "thin": "1px", "thick": "2px", "accent": "3px" },
    "style": {
      "confirmed": "solid",
      "estimate": "dashed",
      "stale": "dashed",
      "unverified": "dashed"
    }
  },

  "chart": {
    "$reason": "차트 선 굵기·대시 패턴·높이는 color/spacing으로 표현할 수 없고 세 기능의 차트가 모두 같아야 한다.",
    "strokeWidth": { "primary": "2px", "multi": "1.5px", "hover": "3px", "threshold": "1px", "budget": "1.5px", "reference": "1px", "axis": "1px", "grid": "1px" },
    "dash": {
      "threshold": "4 4",
      "estimate": "6 3",
      "forecast": "4 4",
      "budget": "8 4",
      "budgetWarn": "2 3",
      "reference": "none",
      "nowLine": "2 2"
    },
    "pointRadius": { "hover": "4px", "marker": "5px" },
    "pointStroke": "2px",
    "hatch": { "angle": "45deg", "lineWidth": "1px", "gap": "4px" },
    "height": { "sparkline": "32px", "sm": "160px", "md": "240px", "lg": "280px", "xl": "320px" },
    "padding": { "top": "12px", "right": "56px", "bottom": "28px", "left": "56px" },
    "barMaxWidth": "24px",
    "barGapRatio": 0.25,
    "barRadiusTop": "2px",
    "tooltip": { "minWidth": "180px", "maxWidth": "300px", "paddingX": "12px", "paddingY": "8px", "swatch": "8px", "offset": "12px" }
