# deploy/k8s-snapshot 설정. 복사해서 .env 로 사용 (.env 는 git 에서 제외됨)
#   cp deploy/k8s-snapshot/.env.example deploy/k8s-snapshot/.env
# 우선순위: 명령줄 플래그 > 이 파일 > 셸 환경변수
# 토큰·인증서·서버 주소는 여기에 적지 않는다. kubeconfig 의 컨텍스트 이름만 적는다.

# 필수. 내보내기 전용 읽기 역할(rbac/export-readonly.yaml)에 연결된 컨텍스트 이름.
# 비우면 종료코드 2 (kubeconfig 의 current-context 를 몰래 쓰지 않는다)
# 대시보드용 컨텍스트·ServiceAccount 토큰을 쓰지 않는다
KUBE_CONTEXT=

# kubeconfig 경로. 비우면 사용자 기본(~/.kube/config, 또는 셸의 KUBECONFIG)
KUBECONFIG=

# 네임스페이스 범위: 포함 목록 또는 제외 목록 (둘 다 쓰면 종료코드 2). 둘 다 비우면 시스템 네임스페이스를 뺀 전체
SNAPSHOT_NAMESPACES=
SNAPSHOT_EXCLUDE_NAMESPACES=
# 시스템 네임스페이스 목록 (대시보드 SYSTEM_NAMESPACES 기본값과 같음)
SNAPSHOT_SYSTEM_NAMESPACES=kube-system,kube-public,kube-node-lease,amazon-cloudwatch

# 선택 종류 켜기: jobs, clusterroles, clusterrolebindings, storageclasses, ingressclasses, priorityclasses, persistentvolumes
SNAPSHOT_OPTIONAL_KINDS=
# 사용자 지정 리소스 (plural.group, 예: targetgroupbindings.elbv2.k8s.aws). 역할에도 get/list 를 더해야 한다
SNAPSHOT_CUSTOM_RESOURCES=
# 기본 포함 종류 중 뺄 것 (예: resourcequotas,limitranges)
SNAPSHOT_EXCLUDE_KINDS=

# Helm 관리 리소스도 내보낼지 (false 면 빼고 개수만 기록)
SNAPSHOT_INCLUDE_HELM=true
# 스캔 경고도 실패로 (종료코드 1)
SNAPSHOT_STRICT=false
# 출력 폴더 (비우면 deploy/k8s-snapshot/snapshots)
SNAPSHOT_OUT_DIR=
