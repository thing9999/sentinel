# k8s-snapshot 전용 (루트 .gitignore 와 별도로 이 폴더에서도 보장)
# 로컬 설정: 컨텍스트 이름·kubeconfig 경로 (비밀값 규칙상 커밋하지 않는다)
.env
.env.*
!.env.example
# 대시보드 휴지통 (지운 스냅샷. git·CLI 스캔 대상 아님, 자동으로 비우지 않음)
snapshots/.trash/
# 대시보드 원자적 저장 도중의 임시 파일
snapshots/**/.*.sentinel-tmp-*
# CLI 가 쓰는 중인 임시 스냅샷 폴더 (끝나면 이름이 바뀌고, 실패하면 지워진다)
snapshots/.*.partial/
node_modules/
