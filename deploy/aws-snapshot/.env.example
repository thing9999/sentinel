# deploy/aws-snapshot 설정. 복사해서 .env 로 사용 (.env 는 git 에서 제외됨)
#   cp deploy/aws-snapshot/.env.example deploy/aws-snapshot/.env
# 우선순위: 명령줄 플래그 > 이 파일 > 셸 환경변수
# 키(액세스 키·세션 토큰)는 여기에 적지 않는다. ~/.aws 의 프로필을 쓴다.

# 내보내기 전용 읽기 프로필 (대시보드용 프로필과 분리. README "IAM 설정" 참고)
# 비우면 기본 자격증명 체인(환경변수 → ~/.aws default)을 쓴다
AWS_PROFILE=sentinel-snapshot
# 필수. former2 는 리전을 안 주면 ~/.aws/config default 리전을 쓰므로 반드시 명시
AWS_REGION=ap-northeast-2

# 검색 필터: 리소스 JSON 안에 이 문자열이 들어 있는 것만 내보낸다
#   쉼표(,) = 하나라도 포함(OR), & = 모두 포함(AND)
#   예: EKS 클러스터 이름. 태그(kubernetes.io/cluster/<이름>, eks:cluster-name)나 이름에 클러스터명이
#       없는 리소스(VPC, 서브넷, IAM 역할 등)는 빠질 수 있으니 필요하면 쉼표로 추가한다
SNAPSHOT_SEARCH_FILTER=
# 선택: 정규식 필터 (검색 필터와 함께 쓰면 둘 다 만족해야 함)
SNAPSHOT_REGEX_FILTER=

# 포함할 서비스 (쉼표 구분, Former2 서비스 이름: lib/services.mjs KNOWN_SERVICES)
# 비우면 "전체 - 기본 제외 서비스". EKS 구성 권장값:
SNAPSHOT_SERVICES=EKS,EC2,VPC,IAM,ECR,KMS,Route53,CertificateManager,CloudWatch,S3
# 추가로 뺄 서비스 (포함 목록이 있으면 거기서 빼고, 없으면 제외 목록에 더한다)
SNAPSHOT_EXCLUDE_SERVICES=
# 비밀값을 원문으로 읽는 서비스(SecretsManager, SystemsManager, GameLift, Cognito)는 기본 제외.
# true 로 바꾸지 말 것 (바꾸면 비밀값이 템플릿·raw 데이터에 들어갈 수 있음)
SNAPSHOT_ALLOW_SENSITIVE_SERVICES=false

# 기본 VPC·기본 서브넷 같은 AWS 기본 리소스 포함 여부
SNAPSHOT_INCLUDE_DEFAULT_RESOURCES=false
# raw 데이터(former2 가 읽은 원본 JSON) 저장. 비밀값이 섞일 수 있어 기본 false.
# true 면 .raw/<시각>/raw-data.json (git 제외 경로)에만 저장
SNAPSHOT_RAW_DATA=false
# CloudFormation DeletionPolicy (Retain 권장: 스택을 지워도 리소스는 남는다)
SNAPSHOT_CFN_DELETION_POLICY=Retain
# metadata.json 의 계정 ID 마스킹 (템플릿 ARN 안의 계정 ID 는 그대로 남음)
SNAPSHOT_MASK_ACCOUNT_ID=true
# 스캔 경고(UserData 등)도 실패(종료코드 1)로 처리
SNAPSHOT_STRICT_SCAN=false
