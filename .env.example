# 복사해서 .env로 사용 (docker compose가 자동으로 읽음)

# 대시보드 자체 DB (설정·경고 기준 등 저장)
DB_USER=dashboard
DB_PASSWORD=dashboard
DB_NAME=dashboard

# 호스트의 kubeconfig 경로 (api 컨테이너에 읽기 전용으로 마운트)
# !! `kops export kubeconfig --admin`으로 만든 admin kubeconfig를 쓰지 말 것 !!
#    cluster-admin 인증서가 들어 있어 "조회 전용"이 권한으로 막히지 않는다.
#    deploy/rbac.yaml의 ServiceAccount(sentinel-api) 토큰만 담은 kubeconfig를 쓴다 (README "권한" 참고).
#    확인: KUBECONFIG=<이 파일> kubectl auth can-i --list → create/update/patch/delete·secrets 가 없어야 한다
KUBECONFIG_HOST_PATH=~/.kube/sentinel.config

# kOps 클러스터 이름 (보통 FQDN, 예: prod.k8s.example.com).
# 상단바 표시 이름이자 EC2 태그 필터 값(kubernetes.io/cluster/<이름>).
# 비우면 표시 이름만 kubeconfig 현재 context에서 채우고, live 비용 추정은 CLUSTER_NAME_NOT_CONFIGURED
K8S_CLUSTER_NAME=
# 시스템 네임스페이스 ("시스템 숨기기" 필터 대상, 쉼표 구분)
SYSTEM_NAMESPACES=kube-system,kube-public,kube-node-lease
# 마스터 대수(단일·짝수) 판단 (기본 true).
# false면 "마스터 1대(HA 아님)"를 표시만 하고 상태에 넣지 않는다(개발용 단일 마스터 클러스터).
# 어드바이저 사전 점검은 이 값과 무관하게 계속 지적한다
CONTROL_PLANE_HA_EXPECTED=
# metrics.k8s.io 조회 간격(초)
METRICS_INTERVAL_SEC=15

# 모니터링 대상 DB (클러스터 안 Postgres StatefulSet, 명세 가정 A2)
# 대상 StatefulSet: 둘 다 채우거나 둘 다 비운다. 비우면 DB 영역은 "설정 없음"
DB_TARGET_NAMESPACE=
DB_TARGET_STATEFULSET=
# 모니터링 전용 읽기 계정 sentinel_monitor (계정 생성: docs/db/monitor-account.sql)
# 접속은 port-forward로: kubectl port-forward -n <ns> svc/<postgres> 15432:5432
#   - docker compose 안의 api: host.docker.internal:15432
#   - Docker 없이 로컬 실행: localhost:15432
MONITOR_DB_URL=postgres://sentinel_monitor:<password>@host.docker.internal:15432/postgres?application_name=sentinel-monitor
# 선택: 기대 standby 수 (비우면 대상 StatefulSet replicas - 1로 자동 계산)
MONITOR_DB_EXPECTED_STANDBYS=
# DB 상태 조회 간격(초)
DB_HEALTH_INTERVAL_SEC=15

# 선택: Prometheus (PVC 실제 사용량 kubelet_volume_stats_used_bytes)
PROMETHEUS_URL=

# SSE 동시 연결 상한
SSE_MAX_CLIENTS=20

# 데이터 소스 모드: mock | live (기본 mock)
# live에서 연결 설정이 없는 출처(kubeconfig, MONITOR_DB_URL 등)는 mock으로 바꾸지 않고 "알 수 없음"으로 표시
DATA_SOURCE=mock

# AWS (aws-cost 기능). 자격 증명은 ~/.aws를 읽기 전용 마운트해서 사용 (키를 여기 적지 말 것)
# 예: ap-northeast-2 (비우면 aws 체크는 not_configured)
AWS_REGION=
AWS_PROFILE=
AWS_CONFIG_HOST_PATH=~/.aws
# Cost Explorer 캐시 TTL(초). 호출당 $0.01이므로 기본 6시간 (최소 3600)
COST_EXPLORER_CACHE_TTL_SEC=21600
# 선택: 월 예산(USD). 채우면 settings(cost.budget)보다 우선. 비우면 settings 값(기본 없음 → 예산 영역 숨김)
COST_MONTHLY_BUDGET_USD=
# 선택: Cost Explorer 지표 UnblendedCost | AmortizedCost (비우면 settings, 기본 UnblendedCost)
COST_EXPLORER_METRIC=
# 선택: Cost Explorer 일일 호출 상한 (비우면 settings, 기본 40)
COST_EXPLORER_DAILY_CALL_LIMIT=

# architecture-advisor: 호스트에서 도는 agent-bridge (npm run dev --prefix apps/agent-bridge)
# 컨테이너 안의 api는 host.docker.internal로 접근 (docker-compose.yml에서 지정)
AGENT_BRIDGE_URL=http://localhost:3002
# agent-bridge의 BRIDGE_TOKEN과 같은 값. 비어 있으면 브리지는 로컬 전용(127.0.0.1) 모드
AGENT_BRIDGE_TOKEN=
# 선택: 어드바이저 브리지 호출 방식 mock | live
# DATA_SOURCE=mock + ADVISOR_BRIDGE=live면 mock 스냅샷으로 로컬 Claude Code에 실제 분석을 요청
ADVISOR_BRIDGE=
# 선택: 어드바이저 출력 방식 structured | text (기본 structured)
ADVISOR_OUTPUT_MODE=
# 선택: 지연 기준(초, 기본 300) / 시간 초과(초, 기본 600) / 1회 비용 상한(USD, 기본 2.0). 비우면 settings → 기본값
ADVISOR_SLOW_AFTER_SEC=
ADVISOR_TIMEOUT_SEC=
ADVISOR_MAX_BUDGET_USD=
# 선택: 1회 최대 턴 수(정수 1~5, 기본 5). 비우면 settings → 기본값
ADVISOR_MAX_TURNS=

# aws-snapshot-manager ("AWS 스냅샷" 메뉴): deploy/aws-snapshot/snapshots 폴더 보기·편집·휴지통
# docker compose는 AWS_SNAPSHOT_DIR/LIB_DIR를 컨테이너 경로로 직접 지정한다 (docker-compose.yml).
# 마운트할 호스트 폴더 (docker compose 전용). 폴더가 없으면 먼저 한 번 export 하거나 만들어 둘 것
AWS_SNAPSHOT_HOST_DIR=./deploy/aws-snapshot/snapshots
# Docker 없이 실행(npm run start:dev --prefix apps/api)할 때: apps/api 기준 상대 경로
#   AWS_SNAPSHOT_DIR=../../deploy/aws-snapshot/snapshots
# 비우면 live 모드에서 메뉴가 "알 수 없음(설정 없음)" (mock 모드는 예시 스냅샷)
AWS_SNAPSHOT_DIR=
# CLI 스캐너 lib 위치 (비우면 apps/api 기준 ../../deploy/aws-snapshot/lib)
AWS_SNAPSHOT_LIB_DIR=
# 쓰기 기능 전체 스위치 (기본 true). false면 보기만
AWS_SNAPSHOT_WRITE_ENABLED=
# "내보내기 진행 중일 수 있음" 기준(분, 기본 30)
AWS_SNAPSHOT_IN_PROGRESS_MIN=
# 편집 상한(바이트, 기본 5242880 = 5 MB) / 보기 상한(기본·최소 20971520 = 20 MB)
AWS_SNAPSHOT_EDIT_MAX_BYTES=
AWS_SNAPSHOT_VIEW_MAX_BYTES=
# 변경 감지 주기(초, 5~25, 기본 10)
AWS_SNAPSHOT_POLL_INTERVAL_SEC=
# 화면에 보일 폴더 경로 (비우면 AWS_SNAPSHOT_DIR)
AWS_SNAPSHOT_DISPLAY_PATH=

# k8s-snapshot ("스냅샷" 메뉴 Kubernetes 탭): deploy/k8s-snapshot/snapshots 폴더 보기·편집·휴지통 + 드리프트
# docker compose는 K8S_SNAPSHOT_DIR/LIB_DIR를 컨테이너 경로로 직접 지정한다 (docker-compose.yml).
# 마운트할 호스트 폴더 (docker compose 전용). 폴더는 snapshots/.gitkeep 으로 항상 있다
K8S_SNAPSHOT_HOST_DIR=./deploy/k8s-snapshot/snapshots
# Docker 없이 실행할 때: apps/api 기준 상대 경로
#   K8S_SNAPSHOT_DIR=../../deploy/k8s-snapshot/snapshots
# 비우면 live 모드에서 Kubernetes 탭이 "알 수 없음(설정 없음)" (mock 모드는 예시 스냅샷, 폴더를 읽지 않음)
# 클러스터 안 배포(deploy/app.example.yaml)에는 넣지 않는다
K8S_SNAPSHOT_DIR=
# 정리·드리프트 규칙 lib 위치 (비우면 apps/api 기준 ../../deploy/k8s-snapshot/lib). 스캐너는 AWS_SNAPSHOT_LIB_DIR 를 같이 쓴다
K8S_SNAPSHOT_LIB_DIR=
# 쓰기 기능 전체 스위치 (기본 true). false면 보기만
K8S_SNAPSHOT_WRITE_ENABLED=
# "내보내기 진행 중일 수 있음" 기준(분, 기본 30)
K8S_SNAPSHOT_IN_PROGRESS_MIN=
# 편집 상한(바이트, 기본 5242880) / 보기 상한(기본·최소 20971520)
K8S_SNAPSHOT_EDIT_MAX_BYTES=
K8S_SNAPSHOT_VIEW_MAX_BYTES=
# 변경 감지 주기(초, 5~25, 기본 10)
K8S_SNAPSHOT_POLL_INTERVAL_SEC=
# 화면·명령 예시에 보일 폴더 경로 (비우면 K8S_SNAPSHOT_DIR)
K8S_SNAPSHOT_DISPLAY_PATH=
# 드리프트: 클러스터 변경 후 재계산 조절(초, 5~20, 기본 10) / 변경이 없어도 다시 계산하는 주기(초, 60~900, 기본 300)
K8S_DRIFT_THROTTLE_SEC=
K8S_DRIFT_RECOMPUTE_SEC=
# 3D 구성 그래프 (docs/api/snapshot-3d.md 14절)
# 캐시 개수(1~64, 기본 8) / 묶어 보기 기준(500~20000, 기본 3000) / 안전 상한
K8S_GRAPH_CACHE_SIZE=
K8S_GRAPH_GROUP_THRESHOLD=
K8S_GRAPH_MAX_BLOCKS=
K8S_GRAPH_MAX_EDGES=

# alerts (상태 알림, docs/api/alerts.md 9절)
# 디스코드 발송 방식 mock | live. 비우면 DATA_SOURCE를 따른다.
# mock이면 디스코드로 나가는 요청이 0건이다 (DATA_SOURCE=live + ALERTS_DISPATCH=mock = 비상 차단 스위치)
ALERTS_DISPATCH=
# 선택: 디스코드 웹훅 주소. **비밀값이다** (주소를 아는 사람은 누구나 그 채널에 글을 쓸 수 있다).
# 설정하면 DB 값을 읽지 않고 이 값이 이기며, 화면 입력이 잠긴다(저장 시도는 409).
# 커밋하지 말 것 — .env에만 둔다
ALERTS_DISCORD_WEBHOOK_URL=
# 선택: 알림 본문에 붙일 대시보드 주소 (예: https://sentinel.example.com). 비우면 링크를 붙이지 않는다
ALERTS_PUBLIC_BASE_URL=

# logs (컨테이너 로그 조회, docs/api/logs.md 10절)
# 로그 기능 스위치. 끄면 GET /api/logs/capabilities만 200(enabled:false)이고 나머지는 403.
# **클러스터 안 배포(deploy/app.example.yaml)는 false가 기본**이다 (PM 결정 Q4)
LOGS_ENABLED=true
# 로그 조회를 막을 네임스페이스 (쉼표 구분). 비밀이 아니라 설정값이라 화면에 그대로 보인다
LOG_DENY_NAMESPACES=
# 조회 줄 수 기본 / 상한
LOG_DEFAULT_LINES=500
LOG_MAX_LINES=5000
# 한 번에 가져올 바이트 상한 / 한 줄 길이 상한
LOG_MAX_BYTES=5242880
LOG_MAX_LINE_BYTES=8192
# 동시 로그 스트림 상한. **SSE_MAX_CLIENTS와 별도로 센다** (로그가 3개 차도 공용 스트림은 영향 없음)
LOG_MAX_STREAMS=3
# 따라가기 초당 줄 수 상한 / 유휴 자동 일시정지(초) / 한 스트림 최대 지속(분)
LOG_STREAM_MAX_LPS=2000
LOG_STREAM_IDLE_PAUSE_SEC=300
LOG_STREAM_MAX_MIN=30
# 가림 규칙 **추가**만 가능 (정규식, 줄바꿈 구분). 끄는 설정은 만들지 않는다
LOG_REDACT_EXTRA_PATTERNS=

# 외부 로그 스택 (logs L2). **비어 있는 것이 정상이다** — 없으면 직접 조회로 동작한다.
# 회사 클러스터에 스택이 있는지는 월요일에 확인한다. `not_configured`는 오류가 아니다.
# 지금 붙어 있는 어댑터는 loki 하나다 (Elasticsearch는 다음 범위)
LOG_BACKEND=
LOG_BACKEND_URL=
# 멀티테넌트 헤더 (Loki X-Scope-OrgID)
LOG_BACKEND_TENANT=
# **비밀값**. 커밋하지 말 것. 오류 메시지·응답에 나오지 않는다
LOG_BACKEND_TOKEN=
LOG_BACKEND_BASIC_AUTH=
LOG_BACKEND_TIMEOUT_SEC=20
# 한 번에 조회할 수 있는 기간 상한(시간)
LOG_BACKEND_MAX_RANGE_HOURS=168
# 보관 기간(시간). 알면 채운다 — 화면 "보관 7일" 칩과 안내에 쓴다
LOG_BACKEND_RETENTION_HOURS=
# 회사 Loki의 라벨 이름이 다르면 여기서 바꾼다 (코드를 고치지 않는다)
LOG_BACKEND_LABEL_NAMESPACE=namespace
LOG_BACKEND_LABEL_POD=pod
LOG_BACKEND_LABEL_CONTAINER=container
LOG_BACKEND_LABEL_NODE=node_name
LOG_BACKEND_LABEL_STREAM=stream
